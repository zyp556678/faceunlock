#!/usr/bin/python3
"""PAM 认证助手 —— 由 pam_faceunlock.so 以 root 身份 fork/exec 的一次性进程。

注意：shebang 必须是解释器**绝对路径**。本进程由 libpam 直接 execv，
不经过 shell，环境变量（尤其 PATH）不可依赖。

用法: faceunlock-auth <user> <service> [rhost] [tty]

退出码（与 pam_faceunlock.so 约定）:
  0  人脸匹配成功          -> PAM_SUCCESS
  1  明确不匹配            -> PAM_AUTH_ERR（PAM 栈继续，通常是 pam_unix 提示密码）
  2  不适用/不确定         -> PAM_IGNORE（未录入、未启用、无摄像头、冷却中、远程、异常）

绝不返回"拒绝"以外的第三态给 PAM：所有异常路径都是 2，保证永远能回退密码。
"""
from __future__ import annotations

import os
import sys

_BASE = os.environ.get("FACEUNLOCK_BASE", "/usr/lib/faceunlock")
if not os.path.isdir(os.path.join(_BASE, "faceunlock")):
    # 开发态：本脚本位于 <repo>/bin/
    _BASE = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
for _p in (os.path.join(_BASE, "vendor"), _BASE):
    if os.path.isdir(_p) and _p not in sys.path:
        sys.path.insert(0, _p)

from faceunlock import EXIT_NOT_APPLICABLE  # noqa: E402


def main(argv: list[str]) -> int:
    if len(argv) < 3:
        print("usage: faceunlock-auth <user> <service> [rhost] [tty]", file=sys.stderr)
        return EXIT_NOT_APPLICABLE
    user, service = argv[1], argv[2]
    rhost = argv[3] if len(argv) > 3 else ""
    tty = argv[4] if len(argv) > 4 else ""

    try:
        from faceunlock.auth import authenticate
        res = authenticate(user, service, rhost=rhost, tty=tty)
        # 所有输出一律走 stderr —— **绝不写 stdout**。
        # PAM 应用可能把 stdout 当作自己的协议通道（polkit-agent-helper-1 就是：
        # 它在 stdout 上写 "PAM_TEXT_INFO ..."/"SUCCESS" 与 gnome-shell 通信）。
        # 我们往 stdout 多写一行普通文本，就会让对方协议解析失败，
        # 表现为"人脸识别成功但授权对话框无限重试"。
        if res.code == 0:
            print(f"人脸识别通过：{user}（相似度 {res.score:.3f}）", file=sys.stderr)
        else:
            print(f"faceunlock: 未通过（{res.reason}），已回退密码认证", file=sys.stderr)
        return res.code
    except Exception as e:  # 任何意外都必须回退密码
        print(f"faceunlock: 内部错误({e})，已回退密码认证", file=sys.stderr)
        return EXIT_NOT_APPLICABLE


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
