#!/bin/sh
# faceunlock postrm
set -e

if [ "$1" = "purge" ]; then
    # 仅在 purge 时删除生物特征数据。remove 时保留，
    # 这样重装/升级不会丢失已录入的人脸。
    rm -rf /var/lib/faceunlock
    rm -rf /etc/faceunlock
    # polkit 沙箱例外也要清干净（prerm 已经处理过，这里兜底老版本残留）
    rm -f /etc/systemd/system/polkit-agent-helper@.service.d/10-faceunlock-camera.conf
    rmdir /etc/systemd/system/polkit-agent-helper@.service.d 2>/dev/null || true
    if [ -d /run/systemd/system ] && command -v systemctl >/dev/null 2>&1; then
        systemctl daemon-reload >/dev/null 2>&1 || true
    fi
fi

#DEBHELPER#

exit 0
